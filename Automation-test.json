    {
      "parameters": {
        "jsCode": "// Đọc target/cucumber.json (Cucumber tự sinh) -> mỗi scenario FAIL = 1 item khớp cột bảng failed_test_cases\nconst features = JSON.parse($input.first().json.stdout);\nconst browser = $('Build args').first().json.browser;\nconst out = [];\n\nfor (const feature of features) {\n  const featureTags = (feature.tags || []).map(t => t.name);\n  let background = null; // Cucumber xuất Background thành 1 element riêng ngay trước scenario\n\n  for (const el of feature.elements || []) {\n    if (el.type === 'background') { background = el; continue; }\n\n    const steps = [...(background ? background.steps : []), ...el.steps];\n    const hooks = [...(el.before || []), ...(el.after || [])];\n    const failedStep = steps.find(s => s.result.status !== 'passed')\n      || hooks.find(h => h.result.status === 'failed');\n    if (!failedStep) continue; // scenario pass -> bỏ qua\n\n    const tags = (el.tags || []).map(t => t.name)\n      .filter(t => !featureTags.includes(t) && !t.startsWith('@epic_') && !t.startsWith('@SEVERITY='));\n    const sev = (el.tags || []).map(t => t.name).find(t => t.startsWith('@SEVERITY='));\n    const err = failedStep.result.error_message || ('Status: ' + failedStep.result.status);\n\n    out.push({ json: {\n      test_case_id: tags.length ? tags[0].slice(1) : el.name,\n      test_case_name: el.name,\n      test_suite: feature.name,\n      environment: 'local-' + browser,\n      build_version: 'local-' + new Date().toISOString().slice(0, 16),\n      severity: sev ? sev.split('=')[1] : 'Medium',\n      steps_to_reproduce: steps.map((s, i) => `${i + 1}. ${s.keyword}${s.name}`).join('\\n'),\n      expected_result: `Step \"${failedStep.keyword || ''}${failedStep.name || ''}\" phải PASSED`,\n      actual_result: `Step ${failedStep.result.status}: ${err.split('\\n')[0]}`,\n      error_message: err.split('\\n')[0],\n      stack_trace: err,\n    }});\n  }\n}\nreturn out; // không có scenario fail -> [] -> workflow dừng"
      },
      "type": "n8n-nodes-base.code",
